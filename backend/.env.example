# Fapshi Payment Gateway Configuration (Sandbox vs Production)
# Never expose these keys inside the Flutter client build!
FAPSHI_API_USER=your_fapshi_api_user
FAPSHI_API_KEY=your_fapshi_api_key
FAPSHI_BASE_URL=https://sandbox.fapshi.com

# Application & CORS Configuration for Flutter Web
APP_URL=http://localhost:8080
CORS_ALLOW_ORIGIN=*
PORT=5000
